# Zendesk MCP server configuration
#
# Access token: MintMCP forwards it as Authorization: Bearer <token> per-request.
# Subdomain: set as env var on the container.
SUBDOMAIN=your_subdomain

# Mode: readonly (default) or readwrite
# readwrite enables create_ticket, update_ticket, create_ticket_comment.
ZENDESK_MCP_MODE=readonly

# HTTP server port
PORT=8000
